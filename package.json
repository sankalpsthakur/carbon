{
  "name": "@sankalpsthakur/carbon",
  "version": "1.0.0",
  "description": "Open-source Claude Code SDK for end-to-end Scope 1/2/3 decarbonisation workflows",
  "license": "Apache-2.0",
  "author": "Sankalp Thakur",
  "keywords": [
    "carbon-accounting",
    "sustainability",
    "scope-1",
    "scope-2",
    "scope-3",
    "ghg-protocol",
    "esg",
    "claude-code",
    "plugin",
    "mcp",
    "decarbonisation"
  ],
  "homepage": "https://github.com/sankalpsthakur/carbon#readme",
  "bugs": {
    "url": "https://github.com/sankalpsthakur/carbon/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sankalpsthakur/carbon.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "carbon": "plugins/shared-services/tools/carbon-cli.js"
  },
  "scripts": {
    "test": "npm --prefix plugins test",
    "test:smoke": "npm --prefix plugins run test:smoke",
    "validate": "npm --prefix plugins run validate"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "better-sqlite3": "^11.7.0"
  },
  "optionalDependencies": {},
  "files": [
    "plugins/",
    "carbon",
    "README.md",
    "!**/__tests__/",
    "!**/test-e2e/",
    "!**/test-fixtures/",
    "!**/test-output/",
    "!**/tests/",
    "!**/scripts/",
    "!**/*.test.js",
    "!**/*.spec.js",
    "!**/test-*.js",
    "!**/test-*.sh",
    "!**/*.sh",
    "!**/*.py",
    "!**/*.py[cod]",
    "!**/__pycache__/",
    "!**/validate-*.js",
    "!**/validation-*.json",
    "!**/generate-demo-data.js",
    "!**/seed-demo-data.js",
    "!**/load-demo-data.js",
    "!**/Architecture.md",
    "!**/Documentation.md",
    "!**/Implement.md",
    "!**/Plans.md",
    "!**/Prompt.md",
    "!**/CHANGELOG.md",
    "!**/CASE_COVERAGE.md",
    "!**/CALC_MODULE_UPDATES.md",
    "!**/README_CALC_COMPLETE.md",
    "!**/EXECUTION_MODULE_IMPLEMENTATION.md",
    "!**/EXPORT_GUIDE.md",
    "!**/FRONTEND_INTEGRATION_GUIDE.md",
    "!**/FRONTEND_QUICKSTART.md",
    "!**/EXECUTION_CHECKLIST.md",
    "!plugins/.claude/",
    "!plugins/.claude-plugin/",
    "!plugins/teams/",
    "!plugins/run-rapid-baseline-real.js",
    "!plugins/package-lock.json"
  ]
}
