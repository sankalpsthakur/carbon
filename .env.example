# CarbonKit Environment Configuration
# Copy to .env and fill in values.
# All variables are prefixed with CARBONKIT_ for namespacing.

# ─── Transport ────────────────────────────────────────────────────────────────
# "stdio" (default for Claude Code) or "http" (for Docker / self-hosted)
CARBONKIT_MCP_TRANSPORT=stdio

# ─── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error (default: info)
CARBONKIT_LOG_LEVEL=info

# ─── Authentication ───────────────────────────────────────────────────────────
# HS256 secret for JWT bearer tokens on HTTP transport.
# Leave empty to disable auth (open mode, suitable for local dev).
CARBONKIT_AUTH_SECRET=
# Token TTL in seconds (default: 3600 = 1 hour)
# CARBONKIT_AUTH_TTL=3600

# ─── MCP Server Ports (HTTP transport only) ──────────────────────────────────
CARBONKIT_MCP_PORT_CALC=8401
CARBONKIT_MCP_PORT_EXEC=8402
CARBONKIT_MCP_PORT_STRATEGY=8403
CARBONKIT_MCP_PORT_SCOPE12=8404
CARBONKIT_MCP_PORT_SWARM=8405
CARBONKIT_MCP_PORT_CONNECTORS=8406

# ─── Storage Backend ─────────────────────────────────────────────────────────
# json (default FileStore), sqlite, postgres
CARBONKIT_STORE_BACKEND=json
# Path to SQLite database file (sqlite backend only)
# CARBONKIT_SQLITE_PATH=./carbonkit.db
# Postgres connection URL (postgres backend only)
# CARBONKIT_DB_URL=postgres://carbonkit:password@localhost:5432/carbonkit
# Postgres password for docker-compose overlay
# CARBONKIT_DB_PASSWORD=carbonkit_dev

# ─── Data Directories (override defaults) ────────────────────────────────────
# CARBONKIT_DATA_DIR=/path/to/shared/data
# CARBONKIT_BLOB_DIR=/path/to/blob/storage

# ─── LLM Router ──────────────────────────────────────────────────────────────
# Backend: anthropic (default) | ollama | vllm | llamacpp
CARBONKIT_LLM_BACKEND=anthropic
# Base URL for LLM backend (auto-detected per backend if not set)
# CARBONKIT_LLM_URL=https://api.anthropic.com
# Model identifier
CARBONKIT_LLM_MODEL=claude-sonnet-4-5-20250929
# API key for LLM provider
# CARBONKIT_LLM_API_KEY=
# Falls back to ANTHROPIC_API_KEY if set
# ANTHROPIC_API_KEY=
# Max tokens for generation (default: 4096)
# CARBONKIT_LLM_MAX_TOKENS=4096
# LLM router standalone port (when running as proxy)
# CARBONKIT_LLM_ROUTER_PORT=8410

# ─── Connector Credentials (optional, per-connector) ─────────────────────────
# SAP S/4HANA
# CARBONKIT_SAP_BASE_URL=
# CARBONKIT_SAP_API_KEY=
# CARBONKIT_SAP_CLIENT=

# Oracle NetSuite
# CARBONKIT_NETSUITE_ACCOUNT_ID=
# CARBONKIT_NETSUITE_TOKEN=
# CARBONKIT_NETSUITE_TOKEN_SECRET=

# QuickBooks
# CARBONKIT_QUICKBOOKS_CLIENT_ID=
# CARBONKIT_QUICKBOOKS_CLIENT_SECRET=
# CARBONKIT_QUICKBOOKS_REALM_ID=

# Xero
# CARBONKIT_XERO_CLIENT_ID=
# CARBONKIT_XERO_CLIENT_SECRET=
# CARBONKIT_XERO_TENANT_ID=

# Concur
# CARBONKIT_CONCUR_CLIENT_ID=
# CARBONKIT_CONCUR_CLIENT_SECRET=

# Coupa
# CARBONKIT_COUPA_BASE_URL=
# CARBONKIT_COUPA_API_KEY=

# Brex / Ramp
# CARBONKIT_BREX_API_KEY=
# CARBONKIT_RAMP_API_KEY=

# Dynamics 365
# CARBONKIT_DYNAMICS_TENANT_ID=
# CARBONKIT_DYNAMICS_CLIENT_ID=
# CARBONKIT_DYNAMICS_CLIENT_SECRET=

# ─── Metrics ──────────────────────────────────────────────────────────────────
# Enable Prometheus metrics endpoint (default: true in HTTP mode)
# CARBONKIT_METRICS_ENABLED=true
# Metrics port (default: 9090)
# CARBONKIT_METRICS_PORT=9090
