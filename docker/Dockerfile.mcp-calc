FROM node:20-alpine

LABEL maintainer="CarbonKit <carbonkit@example.com>"
LABEL description="CarbonKit Scope 3 Calculation MCP Server"

WORKDIR /app

# Copy shared services first (used by all MCP servers)
COPY plugins/shared-services/tools/ /app/shared-services/

# Copy calc plugin
COPY plugins/scope3-calculation/ /app/scope3-calculation/

# Data directory (persisted via volume mount)
RUN mkdir -p /app/scope3-calculation/data

ENV NODE_ENV=production
ENV MCP_TRANSPORT=http
ENV MCP_HTTP_PORT=8401
ENV MCP_SERVER_NAME=calc-mcp

EXPOSE 8401

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:8401/health || exit 1

CMD ["node", "/app/scope3-calculation/tools/calc-mcp.js"]
