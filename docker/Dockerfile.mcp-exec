FROM node:20-alpine

LABEL maintainer="CarbonKit <carbonkit@example.com>"
LABEL description="CarbonKit Execution & Reporting MCP Server"

WORKDIR /app

# Copy shared services
COPY plugins/shared-services/tools/ /app/shared-services/

# Copy exec plugin
COPY plugins/execution-reporting/ /app/execution-reporting/

RUN mkdir -p /app/execution-reporting/data

ENV NODE_ENV=production
ENV MCP_TRANSPORT=http
ENV MCP_HTTP_PORT=8402
ENV MCP_SERVER_NAME=exec-mcp

EXPOSE 8402

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:8402/health || exit 1

CMD ["node", "/app/execution-reporting/tools/exec-mcp.js"]
