{
  "name": "@carbonkit/e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end integration tests for CarbonKit MCP servers",
  "private": true,
  "scripts": {
    "test": "mocha --recursive --require ./helpers/setup.js './**/*.spec.js'",
    "test:calc": "mocha --recursive calc/**/*.spec.js",
    "test:exec": "mocha --recursive exec/**/*.spec.js",
    "test:strategy": "mocha --recursive strategy/**/*.spec.js",
    "test:cross": "mocha --recursive cross-module/**/*.spec.js",
    "test:watch": "mocha --watch --recursive './**/*.spec.js'",
    "test:coverage": "c8 npm test",
    "test:report": "npm test -- --reporter mochawesome --reporter-options reportDir=reports,reportFilename=e2e-report",
    "test:ci": "npm test -- --reporter mocha-junit-reporter --reporter-options mochaFile=./reports/junit.xml",
    "load:test": "artillery run load-test.yml"
  },
  "keywords": [
    "carbonkit",
    "e2e",
    "integration-tests",
    "mcp",
    "carbon-accounting"
  ],
  "author": "CarbonKit Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "artillery": "^2.0.0",
    "c8": "^8.0.1",
    "chai": "^4.3.10",
    "mocha": "^10.2.0",
    "mocha-junit-reporter": "^2.2.1",
    "mochawesome": "^7.1.3",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
